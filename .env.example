# Copy to .env and edit. Used by docker-compose.yml and scripts/start.sh.

# Directory containing the repositories the agents may work on (mounted at /workspace in the container).
CAO_WORKSPACE=./workspace

# Host port for the web UI. Leave empty to let scripts/start.sh pick a free one.
CAO_HOST_PORT=
# Bind address on the host. Keep 127.0.0.1 and use the Cloudflare tunnel for remote access.
CAO_HOST_BIND=127.0.0.1

# --- agent credentials -------------------------------------------------------------
# Option A (recommended): log in on the host (`claude login`, `codex login`) -- the compose file mounts
#           ~/.claude and ~/.codex into the container, so nothing else is needed.
# Option B: API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=            # required for the Grok backend

# GitHub token for `on_success: pr` (or mount a logged-in gh config). Needs repo scope.
GH_TOKEN=

# --- access control ---------------------------------------------------------------
# The UI can start coding agents with write access to your repositories, so it is protected by a token
# whenever it is reachable beyond localhost (tunnel or 0.0.0.0). Leave empty to get a generated one
# (printed at start), or set your own. Sign in once at <url>/login?token=<token>.
CAO_AUTH_TOKEN=

# --- Cloudflare tunnel -------------------------------------------------------------
# Empty  -> quick tunnel: a random https://<words>.trycloudflare.com URL is printed at start (no account).
# Token  -> named tunnel with your own hostname (Cloudflare Zero Trust > Networks > Tunnels > token).
CLOUDFLARE_TUNNEL_TOKEN=
# If you use a named tunnel, put its public URL here so the UI can display it.
CAO_TUNNEL_URL=
