#!/usr/bin/env python3
"""Fake Claude Code CLI: echoes a JSON envelope like `claude -p --output-format json`."""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fakeagent  # noqa: E402

prompt = sys.stdin.read()
args = sys.argv[1:]
if "--version" in args:
    print("9.9.9 (Fake Claude Code)"); sys.exit(0)
if "FAIL_PLEASE" in prompt:
    print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "boom"}))
    sys.exit(0)
model = args[args.index("--model") + 1] if "--model" in args else "default"
# planner behaviour (flow strategies): return a JSON plan when asked
if "Respond with ONLY a JSON array" in prompt:
    text = json.dumps([
        {"title": "Write README", "agent": "claude", "prompt": "Create README.md describing the project."},
        {"title": "Add hello module", "agent": "codex", "prompt": "Create hello.py printing hello."},
    ])
else:
    text = _fakeagent.respond(prompt, os.getcwd(), "fake-claude") or f"[fake-claude:{model}] " + prompt.strip().splitlines()[0][:80]
print(json.dumps({
    "type": "result", "subtype": "success", "is_error": False, "result": text,
    "session_id": "fake", "total_cost_usd": 0.0123, "duration_ms": 42, "num_turns": 1,
    "argv": args,
}))
